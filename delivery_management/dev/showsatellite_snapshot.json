 "server_scripts": [
  {
   "name": "active serial after delete delivery note",
   "script_type": "DocType Event",
   "reference_doctype": "Delivery Note",
   "doctype_event": "After Delete",
   "script": "serial_nos = []\n\nfor item in doc.get(\"items\") or []:\n    raw = item.get(\"serial_no\")\n    if raw:\n        serial_nos = serial_nos + [s.strip() for s in raw.replace(\",\", \"\\n\").split(\"\\n\") if s.strip()]\n\nif serial_nos:\n    existing = frappe.get_all(\n        \"Serial No\",\n        filters={\"name\": [\"in\", list(set(serial_nos))]},\n        pluck=\"name\"\n    )\n\n    for sn in existing:\n        frappe.db.set_value(\"Serial No\", sn, \"status\", \"Active\", update_modified=True)"
  },
  {
   "name": "Delivery Note From Sales Order",
   "script_type": "DocType Event",
   "reference_doctype": "Sales Order",
   "doctype_event": "After Submit",
   "script": "items_to_load = []\r\nfor item in doc.items:\r\n  items_to_load.append({'item_code': item.item_code, 'rate': item.rate, 'qty': item.qty, 'uom': item.uom, 'warehouse': item.warehouse, 'against_sales_order':doc.name, 'so_detail':item.name })\r\n\r\n\r\n\r\nfrappe.get_doc(dict(\r\ndoctype = 'Delivery Note',\r\ntitle = doc.customer,\r\ncustomer = doc.customer_name,\r\ncompany = doc.company,\r\nset_warehouse=doc.set_warehouse,\r\ndocstatus = 0,\r\nitems = items_to_load,\r\n)).insert(ignore_permissions=True)\r\n\r\nfrappe.msgprint(msg=(f'Delivery Note for {doc.customer_name} has been created'),title=('Automation Success'), indicator='green')"
  },
  {
   "name": "invalidate serial after insert delivery note",
   "script_type": "DocType Event",
   "reference_doctype": "Delivery Note",
   "doctype_event": "After Insert",
   "script": "serial_nos = []\n\nfor item in doc.get(\"items\") or []:\n    raw = item.get(\"serial_no\")\n    if raw:\n        serial_nos = serial_nos + [s.strip() for s in raw.replace(\",\", \"\\n\").split(\"\\n\") if s.strip()]\n\nif serial_nos:\n    existing = frappe.get_all(\n        \"Serial No\",\n        filters={\"name\": [\"in\", list(set(serial_nos))]},\n        pluck=\"name\"\n    )\n\n    for sn in existing:\n        frappe.db.set_value(\"Serial No\", sn, \"status\", \"Inactive\", update_modified=True)"
  }
 ],
